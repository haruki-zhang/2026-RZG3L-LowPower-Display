+/* Frame buffer offset */
+#define LCD_SRCM_ADDR_OFFS	(LCD_HACTIVE * LCD_VACTIVE * DISPLAY_FB_BYTE_PER_PIX)
+
+#define COMPUTE_X(index,width) (((LCD_HACTIVE)-(width))*3/2 + (index)%((width)*3))
+#define COMPUTE_Y(index,width,height) (((LCD_VACTIVE)-(height))/2+(height)-i/3/(width))
+
+#define USE_DISPLAY_LIST
+
+static void rzg2l_cpg_init(void);
+static void adv7535_init(void);
+static void adv7535_deinit(void);
+static void rzg2l_dsi_phy_init(void);
+static void rzg2l_dsi_link_init(void);
+static void rzg2l_fpvcg_init(void);
+static void rzg2l_du_init(void);
+static void rzg2l_vcpd_init(void);
+static void rzg2l_vcpd_dl_init(void);
+static void rzg2l_lcdc_start(void);
+static void wait(int bootdelay);
+
+static void rzg2ul_adv7513_init(void);
+static int adv7513_i2c_reg_write(struct udevice *dev, uint addr, uint mask, uint data);
+static int adv7513_i2c_reg_read(struct udevice *dev, uint8_t addr, uint8_t *data);
+
+int rzg2l_video_init(void){
+
+	// adv7535_deinit();
+	rzg2l_cpg_init();
+
+#if (DISPLAY_MODE == PARALLEL_RGB_720P)
+	// Disable GPIO Write Protect
+	(*(volatile u32 *)PFC_PWPR) &= ~(0x1u << 7);	// PWPR.BOWI  = 0
+	(*(volatile u32 *)PFC_PWPR) |= (0x1u << 6);	// PWPR.PFCWE = 1
+
+	*(volatile u32 *)(PFC_OTHER_POC) |= 0x02;	// PVDD_1833_OTH_ISO_POC = 1.8V
+
+	*(volatile u32 *)(PFC_PFC25) = 0x01111111;
+	*(volatile u32 *)(PFC_PFC26) = 0x01111111;
+	*(volatile u32 *)(PFC_PFC27) = 0x11111111;
+	*(volatile u32 *)(PFC_PFC28) = 0x00111111;
+
+	*(volatile u8 *)(PFC_PMC25) = 0x7F;
+	*(volatile u8 *)(PFC_PMC26) = 0x7F;
+	*(volatile u8 *)(PFC_PMC27) = 0xFF;
+	*(volatile u8 *)(PFC_PMC28) = 0x3F;
+
+	// Enable GPIO write Protect
+	*(volatile u32 *)(PFC_PWPR) = 0;
+	*(volatile u32 *)(PFC_PWPR) = PWPR_B0WI;
+
+	rzg2ul_adv7513_init();
+#else
+	rzg2l_dsi_phy_init();
+	rzg2l_dsi_link_init();
+
+	adv7535_init();
+#endif
+
+	/* Load image data for splash screen */
+#if (DISPLAY_MODE == MIPI_DSI_1080P)
+	run_command("ext4load mmc 0:1 0x48000000 boot_img_1080p.bin.gz",0);
+#else
+	run_command("ext4load mmc 0:1 0x48000000 boot_img_720p.bin.gz",0);
+#endif
+	run_command("unzip 0x48000000 0x58000000",0);
+	dcache_disable();
+
+	// rzg2l_fpvcg_init();
+
+	rzg2l_du_init();
+
+#ifdef	USE_DISPLAY_LIST
+	rzg2l_vcpd_dl_init();
+#else
+	rzg2l_vcpd_init();
+#endif	/* USE_DISPLAY_LIST */
+
+	dcache_enable();
+
+	rzg2l_lcdc_start();
+
+	/* Added this delay to display the first FB image.
+	 * This may be removed when an HDMI monitor display is not used.
+	 */
+	wait(1);
+
+	return 0;
+}
