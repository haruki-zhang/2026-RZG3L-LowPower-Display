diff --git a/cmd/booti.c b/cmd/booti.c
index b9637b3ec3..4a5f6b4760 100644
--- a/cmd/booti.c
+++ b/cmd/booti.c
@@ -17,6 +17,10 @@
 #include <linux/sizes.h>
 
 DECLARE_GLOBAL_DATA_PTR;
+
+/* Update splach image */
+void rzg2l_video_update(void);
+
 /*
  * Image booting support
  */
@@ -107,6 +111,9 @@ int do_booti(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 	int states;
 	int ret;
 
+	/* Update splach image */
+	rzg2l_video_update();
+
 	/* Consume 'booti' */
 	argc--; argv++;
 
diff --git a/common/autoboot.c b/common/autoboot.c
index 6f0aeae6bf..ea1562517b 100644
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -57,6 +57,9 @@ static int menukey;
 #define AUTOBOOT_MENUKEY 0
 #endif
 
+/* Update splach image */
+void rzg2l_video_update(void);
+
 /**
  * passwd_abort_crypt() - check for a crypt-style hashed key sequence to abort booting
  *
@@ -405,6 +408,11 @@ static int abortboot_single_key(int bootdelay)
 		} while (!abort && get_timer(ts) < 1000);
 
 		printf("\b\b\b%2d ", bootdelay);
+
+		/* Update splash image */
+		if ((bootdelay == 1) || (bootdelay == 0))
+			rzg2l_video_update();
+
 	}
 
 	putc('\n');
diff --git a/common/board_r.c b/common/board_r.c
index da0b80f24f..e6db74269c 100644
--- a/common/board_r.c
+++ b/common/board_r.c
@@ -67,6 +67,8 @@
 #include <efi_loader.h>
 #include <relocate.h>
 
+#include "../drivers/video/rzg2l/rzg2l_video.h"
+
 DECLARE_GLOBAL_DATA_PTR;
 
 ulong monitor_flash_len;
@@ -739,6 +741,7 @@ static init_fnc_t init_sequence_r[] = {
 #if defined(CFG_PRAM)
 	initr_mem,
 #endif
+	rzg2l_video_init,
 	run_main_loop,
 };
 
