+static display_header_t *dl_headers[3];
+static display_body_t *dl_body[3];
+
+static void rzg2l_vcpd_dl_init(void)
+{
+	int i;
+	display_header_t *header;
+	display_body_t *body;
+
+	printf("VCPD Init for DL\r\n");
+	rzg2l_registers_set(vcpd_dl_register_values,ARRAY_SIZE(vcpd_dl_register_values));
+
+	/* Init DL */
+	dl_headers[0] = (display_header_t *)DISPLAY_LIST_HEADER_0;
+	dl_headers[1] = (display_header_t *)DISPLAY_LIST_HEADER_1;
+	dl_headers[2] = (display_header_t *)DISPLAY_LIST_HEADER_2;
+	for (i = 0; i < 3; i++) {
+		memset(dl_headers[i], 0x00, sizeof (display_header_t));
+	}
+	dl_body[0] = (display_body_t *)DISPLAY_LIST_0;
+	dl_body[1] = (display_body_t *)DISPLAY_LIST_1;
+	dl_body[2] = (display_body_t *)DISPLAY_LIST_2;
+
+	/* Setup DL bodies */
+	body = dl_body[0];
+	for (i = 0; i < (sizeof dl_init)/(sizeof (display_body_t)); i++) {
+		body->address = dl_init[i].address;
+		body->data = dl_init[i].data;
+		body++;
+	}
+	body = dl_body[1];
+	body->address = VSPD_VI6_RPF0_SRCM_ADDR_Y;
+	body->data = LCD_SRCM_ADDR;
+	body = dl_body[2];
+	body->address = VSPD_VI6_RPF0_SRCM_ADDR_Y;
+	body->data = LCD_SRCM_ADDR;
+
+	/* Setup DL headers */
+	header = dl_headers[0];
+	header->num_list = 0;
+	header->list[0].num_bytes = (sizeof dl_init);
+	header->list[0].pList = (uint32_t)dl_body[0];
+	header->pNext_header = DISPLAY_LIST_HEADER_1;
+	header->flags = 1;
+
+	header = dl_headers[1];
+	header->num_list = 0;
+	header->list[0].num_bytes = 1 * (sizeof (display_body_t));
+	header->list[0].pList = (uint32_t)dl_body[1];
+	header->pNext_header = DISPLAY_LIST_HEADER_1;
+	header->flags = 1;
+
+	header = dl_headers[2];
+	header->num_list = 0;
+	header->list[0].num_bytes = 1 * (sizeof (display_body_t));
+	header->list[0].pList = (uint32_t)dl_body[2];
+	header->pNext_header = DISPLAY_LIST_HEADER_2;
+	header->flags = 1;
+}
+
+void rzg2l_video_update(void)
+{
+	display_header_t *header;
+	display_body_t *body;
+	static int count = 0;
+
+	count++;
+	if (count >= LCD_SRCM_FB_NUM)
+		return;
+
+	header = ((count & 1) == 0) ? dl_headers[1]: dl_headers[2];
+	body = (display_body_t *)header->list[0].pList;
+
+	dcache_disable();
+
+	body->data = LCD_SRCM_ADDR + LCD_SRCM_ADDR_OFFS * count;
+	reg_write(VSPD_VI6_DL_HDR_ADDR0, (uint32_t)header);
+
+	dcache_enable();
+}
+
+/* Start LCDC */
+static void rzg2l_lcdc_start(void)
+{
+    //----- Start Video Output -----
+    reg_write(VSPD_base_addr + 0x0000, 0x00000001); // VI6_CMD0: STRCMD=1
+    while ((reg_read(VSPD_base_addr + 0x007C) & 0x00000100) != 0x00000100);// Wait until VI6_DISP0_IRQ_STA.DST=1
+
+#if (DISPLAY_MODE != PARALLEL_RGB_720P)
+    reg_write(DU_base_addr + 0x0000, 0x00000100);   // DU_MCR0 : DI_EN=1
+    while ((reg_read(DSI_LINK_base_addr + ISR) & 0x00000100) != 0x00000100);// ISR.VIN1
+#endif
+}
+
+static void wait(int delay)
+{
+	unsigned long ts;
+
+        while (delay > 0) {
+                --delay;
+                /* delay 1000 ms */
+                ts = get_timer(0);
+                do {
+                        udelay(10000);
+                } while (get_timer(ts) < 1000);
+        }
+}
