+#define PFC_PMC26	(PFC_BASE + 0x0226)
+#define PFC_PMC27	(PFC_BASE + 0x0227)
+#define PFC_PMC28	(PFC_BASE + 0x0228)
+
+#define PFC_PWPR	(PFC_BASE + 0x3000)
+#define PWPR_B0WI	BIT(7)	// Bit Write Disable
+#define PWPR_PFCWE	BIT(6)	// PFC Register Write Enable
+
+#define PFC_OTHER_POC	(PFC_BASE + 0x3028)
