diff --git a/plat/renesas/rz/soc/g3l/plat_ddr_setup.c b/plat/renesas/rz/soc/g3l/plat_ddr_setup.c
index c1c2fc4ea..33476c7fb 100644
--- a/plat/renesas/rz/soc/g3l/plat_ddr_setup.c
+++ b/plat/renesas/rz/soc/g3l/plat_ddr_setup.c
@@ -24,7 +24,56 @@
 
 uint32_t ddr_csr_table[RET_CSR_SIZE] __aligned(8);
 
-#if PLAT_SYSTEM_SUSPEND
+#if PLAT_SYSTEM_SUSPEND_disp
+#include <lib/cassert.h>
+#include <lib/mmio.h>
+#include <lpdemo_disp.h>
+
+CASSERT(LPDEMO_RETCSR_WORDS <= RET_CSR_SIZE, assert_lpdemo_retcsr_words);
+
+/* CRC-32 (IEEE 802.3, reflected, init/xorout 0xFFFFFFFF), as lp_crc32() of the CM33 */
+static uint32_t lpdemo_crc32(const uint32_t *p, uint32_t words)
+{
+	uint32_t crc = 0xFFFFFFFFU;
+
+	for (uint32_t i = 0; i < words; i++) {
+		uint32_t w = p[i];
+
+		for (uint32_t b = 0; b < 32; b++) {
+			uint32_t bit = (w ^ crc) & 1U;
+
+			crc >>= 1;
+			if (bit != 0U)
+				crc ^= 0xEDB88320U;
+			w >>= 1;
+		}
+	}
+	return ~crc;
+}
+
+/*
+ * DISP_RET: the CM33 runs the DDR retention exit, from the retention CSRs saved during the
+ * training. Hand them over in SRAM instead of writing them to the boot media.
+ */
+void plat_ddr_setup(void)
+{
+	uintptr_t data = LPDEMO_RETCSR_BASE + LPDEMO_RETCSR_HDR_SIZE;
+
+	ddr_setup();
+
+	for (uint32_t i = 0; i < LPDEMO_RETCSR_WORDS; i++)
+		mmio_write_32(data + i * 4U, ddr_csr_table[i]);
+	mmio_write_32(LPDEMO_RETCSR_BASE + 0x4U, LPDEMO_RETCSR_WORDS);
+	mmio_write_32(LPDEMO_RETCSR_BASE + 0x8U,
+		      lpdemo_crc32(ddr_csr_table, LPDEMO_RETCSR_WORDS));
+	mmio_write_32(LPDEMO_RETCSR_BASE + 0xCU, 0U);
+	/* BL2 maps the SRAM cacheable: make the snapshot visible to the CM33, magic last */
+	flush_dcache_range(LPDEMO_RETCSR_BASE, LPDEMO_RETCSR_HDR_SIZE + LPDEMO_RETCSR_WORDS * 4U);
+	mmio_write_32(LPDEMO_RETCSR_BASE, LPDEMO_RETCSR_MAGIC);
+	flush_dcache_range(LPDEMO_RETCSR_BASE, LPDEMO_RETCSR_HDR_SIZE);
+	INFO("DDR retention info handed over to the CM33 at 0x%x.\n", LPDEMO_RETCSR_BASE);
+}
+#elif PLAT_SYSTEM_SUSPEND
 static image_info_t ddr_config_info = {
 	.h.type = (uint8_t)PARAM_IMAGE_BINARY,
 	.h.version = (uint8_t)VERSION_2,
@@ -121,4 +170,4 @@ void plat_ddr_setup(void)
 {
 	ddr_setup();
 }
-#endif /* PLAT_SYSTEM_SUSPEND */
+#endif /* PLAT_SYSTEM_SUSPEND_disp / PLAT_SYSTEM_SUSPEND */
