+#if PLAT_SYSTEM_SUSPEND_disp
+/*
+ * RZ/G3L LowPower Display demo (DISP_RET): see pwrc_disp_suspend(). BL31 maps the SRAM
+ * cacheable, the CM33 does not use the CA55 caches: maintain the cache around accesses to
+ * the control block.
+ */
+static bool disp_cm33_alive;
+
+static uint32_t disp_rd(uint32_t off)
+{
+	inv_dcache_range(LPDEMO_CTRL_BASE + off, sizeof(uint32_t));
+	return mmio_read_32(LPDEMO_CTRL_BASE + off);
+}
+
+static void disp_wr(uint32_t off, uint32_t val)
+{
+	mmio_write_32(LPDEMO_CTRL_BASE + off, val);
+	flush_dcache_range(LPDEMO_CTRL_BASE + off, sizeof(uint32_t));
+}
+
+static void disp_stage(uint32_t stage)
+{
+	disp_wr(LPDEMO_OFF_BL31_STAGE, stage);
+	mmio_write_32(LPDEMO_TRACE_BASE + LPDEMO_TRACE_OFF_BL31_STAGE, stage);
+	flush_dcache_range(LPDEMO_TRACE_BASE + LPDEMO_TRACE_OFF_BL31_STAGE, sizeof(uint32_t));
+}
+
+/*
+ * Nobody but the CM33 can wake the CA55 up from DISP_RET: only sleep if its firmware runs
+ * (heartbeat advancing every 10 ms).
+ */
+static bool disp_check_cm33(void)
+{
+	uint32_t hb;
+
+	if (disp_rd(LPDEMO_OFF_MAGIC) != LPDEMO_CTRL_MAGIC ||
+	    disp_rd(LPDEMO_OFF_VERSION) != LPDEMO_CTRL_VERSION ||
+	    disp_rd(LPDEMO_OFF_CM33_STATE) == LPDEMO_CM33_FAULT)
+		return false;
+
+	hb = disp_rd(LPDEMO_OFF_HEARTBEAT);
+	for (int i = 0; i < 10; i++) {
+		mdelay(10);
+		if (disp_rd(LPDEMO_OFF_HEARTBEAT) != hb)
+			return true;
+	}
+	return false;
+}
+
+static void disp_suspend(void)
+{
+	unsigned int core = plat_my_core_pos();
+	uint32_t mode;
+
+	disp_cm33_alive = disp_check_cm33();
+	mode = disp_rd(LPDEMO_OFF_SUSP_MODE);
+	pwrc_disp_puts(mode, "suspend, CM33 alive", disp_cm33_alive ? 1U : 0U);
+	if (!disp_cm33_alive) {
+		disp_stage(LPDEMO_BL31_NO_CM33);
+		return;
+	}
+
+	disp_wr(LPDEMO_OFF_SUSP_COUNT, disp_rd(LPDEMO_OFF_SUSP_COUNT) + 1U);
+	mmio_write_32(LPDEMO_TRACE_BASE + LPDEMO_TRACE_OFF_SUSP_MODE, mode);
+	mmio_write_32(LPDEMO_TRACE_BASE + LPDEMO_TRACE_OFF_SUSP_COUNT,
+		      disp_rd(LPDEMO_OFF_SUSP_COUNT));
+	disp_stage(LPDEMO_BL31_SUSPEND);
+
+	/*
+	 * Wake-up source: MHU software interrupt ch4 (CM33 -> CA55 core 0), as a secure Group 0
+	 * interrupt routed to this core. The CPU interface is left enabled so that the pending
+	 * interrupt ends the WFI (it is not taken: interrupts are masked in EL3).
+	 * plat_gic_save() above recorded the configuration that plat_gic_resume() restores.
+	 */
+	gicv3_set_interrupt_group(LPDEMO_GIC_INTID_WAKE, core, INTR_GROUP0);
+	gicv3_set_interrupt_priority(LPDEMO_GIC_INTID_WAKE, core, GIC_HIGHEST_SEC_PRIORITY);
+	gicv3_set_spi_routing(LPDEMO_GIC_INTID_WAKE, GICV3_IRM_PE, read_mpidr_el1());
+	gicv3_enable_interrupt(LPDEMO_GIC_INTID_WAKE, core);
+
+	/*
+	 * gicv3_distif_init() only enables the groups that have secure interrupts configured,
+	 * none on this platform: Group 0 is off in the Distributor and would never be
+	 * forwarded. Enable it for the sleep; plat_gic_resume() restores GICD_CTLR.
+	 */
+	mmio_setbits_32(RZ_SOC_GICD_BASE + GICD_CTLR, CTLR_ENABLE_G0_BIT);
+	while ((mmio_read_32(RZ_SOC_GICD_BASE + GICD_CTLR) & GICD_CTLR_RWP_BIT) != 0U)
+		;
+	pwrc_disp_puts(mode, "wake-up source set, mode", mode);
+	pwrc_disp_puts(mode, "GICD_CTLR", mmio_read_32(RZ_SOC_GICD_BASE + GICD_CTLR));
+	/* INTID 106 = word 3, bit 10: group (0 = G0), group modifier, enable, pending, route */
+	pwrc_disp_puts(mode, "GICD_IGROUPR3", mmio_read_32(RZ_SOC_GICD_BASE + 0x080U + 12U));
+	pwrc_disp_puts(mode, "GICD_IGRPMODR3", mmio_read_32(RZ_SOC_GICD_BASE + 0xD00U + 12U));
+	pwrc_disp_puts(mode, "GICD_ISENABLER3", mmio_read_32(RZ_SOC_GICD_BASE + 0x100U + 12U));
+	pwrc_disp_puts(mode, "GICD_ISPENDR3", mmio_read_32(RZ_SOC_GICD_BASE + 0x200U + 12U));
+	pwrc_disp_puts(mode, "GICD_IROUTER106",
+		       mmio_read_32(RZ_SOC_GICD_BASE + 0x6000U + 8U * LPDEMO_GIC_INTID_WAKE));
+	pwrc_disp_puts(mode, "MPIDR", (uint32_t)read_mpidr_el1());
+}
+#endif /* PLAT_SYSTEM_SUSPEND_disp */
