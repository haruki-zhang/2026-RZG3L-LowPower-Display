 plat/renesas/rz/soc/g3l/drivers/pwrc/pwrc.c   | 189 ++++++++++++++++++
 plat/renesas/rz/soc/g3l/drivers/sys.c         |   5 +-
 plat/renesas/rz/soc/g3l/include/lpdemo_disp.h |  72 +++++++
 plat/renesas/rz/soc/g3l/include/pwrc.h        |   8 +
 plat/renesas/rz/soc/g3l/plat_ddr_setup.c      |  53 ++++-
 plat/renesas/rz/soc/g3l/plat_pm.c             | 131 +++++++++++-
 7 files changed, 459 insertions(+), 5 deletions(-)
 create mode 100644 plat/renesas/rz/soc/g3l/include/lpdemo_disp.h

diff --git a/plat/renesas/rz/common/g3l_common.mk b/plat/renesas/rz/common/g3l_common.mk
index 5ed286a7d..a658d3d52 100644
--- a/plat/renesas/rz/common/g3l_common.mk
+++ b/plat/renesas/rz/common/g3l_common.mk
@@ -33,6 +33,12 @@ ifneq ($(filter awo vbat,${PLAT_SYSTEM_SUSPEND}),)
 override PLAT_SUSPEND_MODE		:= ${PLAT_SYSTEM_SUSPEND}
 override PLAT_SYSTEM_SUSPEND	:= 1
 PLAT_EMMC_WRITE_ENABLE			:= 1
+else ifeq (${PLAT_SYSTEM_SUSPEND},disp)
+# LowPower Display demo (DISP_RET): PD_ISO stays on, the CA55 sleeps in SRAM with the DDR
+# in retention and is woken up by the CM33. Nothing is written to the boot media: the DDR
+# retention CSRs are handed to the CM33 in SRAM.
+override PLAT_SUSPEND_MODE		:= disp
+override PLAT_SYSTEM_SUSPEND	:= 1
 else
 $(error Unknown suspend mode ${PLAT_SYSTEM_SUSPEND})
 endif
diff --git a/plat/renesas/rz/soc/g3l/drivers/pwrc/pwrc.c b/plat/renesas/rz/soc/g3l/drivers/pwrc/pwrc.c
index bd394a4e3..638428115 100644
--- a/plat/renesas/rz/soc/g3l/drivers/pwrc/pwrc.c
+++ b/plat/renesas/rz/soc/g3l/drivers/pwrc/pwrc.c
@@ -82,6 +82,195 @@ void __dead2 pwrc_suspend_to_ram(void)
 	panic();
 }
 
+#if PLAT_SYSTEM_SUSPEND_disp
+/*
+ * DISP_RET (RZ/G3L LowPower Display demo): PD_ISO stays powered. The display is driven by
+ * the CM33 from SRAM. The CA55 sleeps in WFI running from SRAM, optionally with the DDR in
+ * retention, until the CM33 has restored the DDR and given the display back to Linux; the
+ * CM33 then raises MHU software interrupt ch4 (GIC SPI 74, set up by rz_pwr_domain_suspend())
+ * and the CA55 continues at the BL31 warm entry point, as after a power-down.
+ *
+ * Everything below runs from SRAM (pwrc*.o is in the .sram section) with the MMU off: no
+ * DDR access, no console, until pwrc_go_disp_ret() jumps to the warm entry point.
+ */
+#include <cpg_regs.h>
+#include <lpdemo_disp.h>
+#include <rz_soc_def.h>
+
+#define GICD_ICENABLER_WAKE	(RZ_SOC_GICD_BASE + 0x180U + (LPDEMO_GIC_INTID_WAKE / 32U) * 4U)
+#define GICD_WAKE_BIT		(1U << (LPDEMO_GIC_INTID_WAKE % 32U))
+#define LPDEMO_SUSP_MODE_SKIP	(1U << 31)	/* internal: CM33 not alive, do not sleep */
+#define PLL4_STBY_STANDBY	(PLL4_STBY_RESETB_WEN)
+#define PLL4_WAIT_LOOPS		(1000000U)
+/* CPUPWRCTLR_EL1.CORE_PWRDN_EN (set by cortex_a55_core_pwr_dwn() in the PSCI power-down) */
+#define A55_CORE_PWRDN_EN	(1UL << 0)
+/* ICC_IGRPEN1_EL3: EnableGrp1NS | EnableGrp1S */
+#define ICC_IGRPEN1_EL3_G1_MASK	(3UL)
+
+/*
+ * No writable variables here: plat_copy_code_to_system_ram() maps this code read-only
+ * once copied to SRAM. The parameters are passed on the BL31 stack (DDR), read before the
+ * DDR goes into retention.
+ */
+struct disp_args {
+	uintptr_t warm_ep;
+	uint32_t mode;
+};
+
+/*
+ * Debug output straight to the console SCIF (LPDEMO_SUSP_MODE_DEBUG_UART): works from SRAM
+ * with the MMU off and the DDR in retention. Only used when Linux keeps the console running
+ * through the suspend (console_suspend=N), otherwise the SCIF clock may be off.
+ */
+static void disp_putc(char c)
+{
+	while (((mmio_read_16(LPDEMO_SCIF_FDR) >> 8) & 0x1FU) >= 16U)
+		;
+	mmio_write_8(LPDEMO_SCIF_FTDR, (uint8_t)c);
+}
+
+void pwrc_disp_puts(uint32_t mode, const char *s, uint32_t hex)
+{
+	if ((mode & LPDEMO_SUSP_MODE_DEBUG_UART) == 0U)
+		return;
+	disp_putc('\r');
+	disp_putc('\n');
+	disp_putc('[');
+	for (const char *p = "BL31 "; *p != '\0'; p++)
+		disp_putc(*p);
+	for (; *s != '\0'; s++)
+		disp_putc(*s);
+	disp_putc(' ');
+	for (int i = 28; i >= 0; i -= 4)
+		disp_putc("0123456789abcdef"[(hex >> i) & 0xFU]);
+	disp_putc(']');
+}
+
+static void disp_wr(uint32_t off, uint32_t val)
+{
+	mmio_write_32(LPDEMO_CTRL_BASE + off, val);
+}
+
+static void disp_stage(uint32_t mode, uint32_t stage)
+{
+	disp_wr(LPDEMO_OFF_BL31_STAGE, stage);
+	mmio_write_32(LPDEMO_TRACE_BASE + LPDEMO_TRACE_OFF_BL31_STAGE, stage);
+	dsbsy();
+	pwrc_disp_puts(mode, "stage", stage);
+}
+
+static void __dead2 pwrc_go_disp_ret(void *arg)
+{
+	const struct disp_args *args = arg;
+	uintptr_t warm_ep = args->warm_ep;
+	uint32_t mode = args->mode;
+	uint32_t state = LPDEMO_SUSP_SLEEP;
+	u_register_t pwrctlr;
+	u_register_t igrpen1;
+	u_register_t scr;
+
+	if ((mode & LPDEMO_SUSP_MODE_SKIP) != 0U)
+		goto warm_entry;
+
+	disp_stage(mode, LPDEMO_BL31_SRAM);
+
+	if ((mode & LPDEMO_SUSP_MODE_DDR_RET) != 0U) {
+		/* 12.1-12.12: DRAM self-refresh, PHY IO retention, controller in reset */
+		ddr_retention_entry();
+		disp_stage(mode, LPDEMO_BL31_DDR_RET);
+		mmio_write_32(CPG_PLL4_STBY, PLL4_STBY_STANDBY);
+		for (uint32_t i = 0; i < PLL4_WAIT_LOOPS; i++) {
+			if ((mmio_read_32(CPG_PLL4_MON) &
+			     (PLL4_MON_PLL4_RESETB | PLL4_MON_PLL4_LOCK)) == 0U)
+				break;
+		}
+		disp_stage(mode, LPDEMO_BL31_PLL4_OFF);
+		state = LPDEMO_SUSP_RETENTION;
+	}
+
+	/* The CM33 starts the wake-up handling from here (USER_SW3 / timer) */
+	disp_wr(LPDEMO_OFF_SUSP_STATE, state);
+	dsbsy();
+
+	/* WFI must be a standby, not a power-down request: the core keeps its power */
+	__asm__ volatile("mrs %0, S3_0_C15_C2_7" : "=r" (pwrctlr));
+	pwrctlr &= ~A55_CORE_PWRDN_EN;
+	__asm__ volatile("msr S3_0_C15_C2_7, %0" : : "r" (pwrctlr));
+	isb();
+
+	/*
+	 * Only the MHU interrupt (Group 0) may end the WFI: a pending Linux interrupt (Group 1)
+	 * would make the CA55 spin in the loop below. Linux re-enables Group 1 on resume.
+	 */
+	__asm__ volatile("mrs %0, S3_6_C12_C12_7" : "=r" (igrpen1));
+	__asm__ volatile("msr S3_6_C12_C12_7, %0" : : "r" (igrpen1 & ~ICC_IGRPEN1_EL3_G1_MASK));
+	isb();
+
+	/*
+	 * Route IRQ/FIQ to EL3 for the WFI, as rz_cpu_standby() does: an interrupt targeted at
+	 * a lower EL does not end a WFI executed in EL3. Group 0 is signalled as FIQ; it is
+	 * not taken (PSTATE masks it in EL3), it only wakes the core up.
+	 */
+	scr = read_scr_el3();
+	write_scr_el3(scr | SCR_IRQ_BIT | SCR_FIQ_BIT);
+	isb();
+
+	if ((mode & LPDEMO_SUSP_MODE_PLAIN_WFI) == 0U)
+		mmio_write_32(SYS_LP_CTL2, CA55_STBYCTL_SLEEP_START);
+
+	disp_stage(mode, LPDEMO_BL31_WFI);
+	for (;;) {
+		dsbsy();
+		wfi();
+		/* Wake-ups other than the CM33 (spurious, other interrupts) go back to sleep */
+		if (mmio_read_32(LPDEMO_CTRL_BASE + LPDEMO_OFF_SUSP_STATE) == LPDEMO_SUSP_RESUMED)
+			break;
+		pwrc_disp_puts(mode, "spurious wake-up, MHU",
+			       mmio_read_32(LPDEMO_MHU_SW_INT_STS4));
+	}
+
+	mmio_write_32(SYS_LP_CTL2, CA55_STBYCTL_RESUME_START);
+	write_scr_el3(scr);
+	__asm__ volatile("msr S3_6_C12_C12_7, %0" : : "r" (igrpen1));
+	isb();
+	disp_stage(mode, LPDEMO_BL31_WOKEN);
+
+	/* Negate the MHU interrupt and turn it off; plat_gic_resume() restores the GIC */
+	mmio_write_32(LPDEMO_MHU_SW_INT_CLR4, 1U);
+	mmio_write_32(GICD_ICENABLER_WAKE, GICD_WAKE_BIT);
+	dsbsy();
+	disp_wr(LPDEMO_OFF_SUSP_STATE, LPDEMO_SUSP_NONE);
+
+warm_entry:
+	disp_stage(mode, LPDEMO_BL31_WARM_ENTRY);
+	/* The DDR image of BL31 is intact: continue there as after a power-down */
+	__asm__ volatile("ic iallu\n"
+			 "tlbi alle3\n"
+			 "dsb sy\n"
+			 "isb\n"
+			 "br %0\n" : : "r" (warm_ep) : "memory");
+	__builtin_unreachable();
+}
+
+void __dead2 pwrc_disp_suspend(uintptr_t warm_ep, uint32_t mode, bool cm33_alive)
+{
+	/* On the BL31 stack: written back by the cache flush below, read with the MMU off */
+	struct disp_args args = {
+		.warm_ep = warm_ep,
+		.mode = cm33_alive ? mode : LPDEMO_SUSP_MODE_SKIP,
+	};
+
+	/* Forces the stores and writes them back (they are read with the MMU and caches off) */
+	flush_dcache_range((uintptr_t)&args, sizeof(args));
+	dcsw_op_all(DCCISW);
+	disable_mmu_el3();
+
+	pwrc_func_call_with_pmustack((uintptr_t)pwrc_go_disp_ret, &args);
+
+	panic();
+}
+#endif /* PLAT_SYSTEM_SUSPEND_disp */
+
 void pwrc_setup(void)
 {
 	const uint32_t rval[PLATFORM_CORE_COUNT][2] = {
diff --git a/plat/renesas/rz/soc/g3l/drivers/sys.c b/plat/renesas/rz/soc/g3l/drivers/sys.c
index 5821e1eee..91b6abc1a 100644
--- a/plat/renesas/rz/soc/g3l/drivers/sys.c
+++ b/plat/renesas/rz/soc/g3l/drivers/sys.c
@@ -79,7 +79,10 @@ bool sys_is_m33_core_booted(void)
 
 bool sys_is_resume_reboot(void)
 {
-#if PLAT_SYSTEM_SUSPEND
+#if PLAT_SYSTEM_SUSPEND_disp
+	/* DISP_RET never resumes through BL2 (and RIIC0 belongs to the CM33) */
+	return false;
+#elif PLAT_SYSTEM_SUSPEND
 	return pwrc_board_is_resume();
 #else
 	return false;
diff --git a/plat/renesas/rz/soc/g3l/include/lpdemo_disp.h b/plat/renesas/rz/soc/g3l/include/lpdemo_disp.h
new file mode 100644
index 000000000..6a77aa16f
--- /dev/null
+++ b/plat/renesas/rz/soc/g3l/include/lpdemo_disp.h
@@ -0,0 +1,72 @@
+/*
+ * Copyright (c) 2026, Renesas Electronics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * RZ/G3L LowPower Display demo (PLAT_SYSTEM_SUSPEND=disp): shared SRAM areas used with the
+ * CM33 firmware. Mirror of lpdemo_shared.h (meta-rzg3l-lp-display, lpdemo-cm33-fw),
+ * which checks these offsets with static asserts.
+ */
+#ifndef LPDEMO_DISP_H
+#define LPDEMO_DISP_H
+
+/* Control block (struct lpdemo_ctrl, version 4; BL31 uses the fields of v3) */
+#define LPDEMO_CTRL_BASE		U(0x0005B000)
+#define LPDEMO_CTRL_MAGIC		U(0x4344504C)	/* "LPDC" */
+#define LPDEMO_CTRL_VERSION		U(4)
+#define LPDEMO_OFF_MAGIC		U(0x00)
+#define LPDEMO_OFF_VERSION		U(0x04)
+#define LPDEMO_OFF_CM33_STATE		U(0x10)
+#define LPDEMO_OFF_HEARTBEAT		U(0x14)
+#define LPDEMO_OFF_SUSP_MODE		U(0xE0)
+#define LPDEMO_OFF_SUSP_STATE		U(0xE4)
+#define LPDEMO_OFF_SUSP_COUNT		U(0xE8)
+#define LPDEMO_OFF_BL31_STAGE		U(0xFC)
+
+#define LPDEMO_CM33_FAULT		U(0xEE)
+
+#define LPDEMO_SUSP_MODE_DDR_RET	(U(1) << 0)
+#define LPDEMO_SUSP_MODE_PLAIN_WFI	(U(1) << 1)
+#define LPDEMO_SUSP_MODE_DEBUG_UART	(U(1) << 3)	/* progress on the console (SCIF0) */
+
+#define LPDEMO_SUSP_NONE		U(0)
+#define LPDEMO_SUSP_SLEEP		U(1)
+#define LPDEMO_SUSP_RETENTION		U(2)
+#define LPDEMO_SUSP_RESUMED		U(4)
+
+#define LPDEMO_BL31_SUSPEND		U(0x3101)
+#define LPDEMO_BL31_NO_CM33		U(0x31A1)
+#define LPDEMO_BL31_SRAM		U(0x3102)
+#define LPDEMO_BL31_DDR_RET		U(0x3103)
+#define LPDEMO_BL31_PLL4_OFF		U(0x3104)
+#define LPDEMO_BL31_WFI			U(0x3105)
+#define LPDEMO_BL31_WOKEN		U(0x3106)
+#define LPDEMO_BL31_WARM_ENTRY		U(0x3107)
+#define LPDEMO_BL31_RESUMED		U(0x3108)
+
+/* DDR retention CSR snapshot for the CM33 (struct lpdemo_retcsr_hdr + data) */
+#define LPDEMO_RETCSR_BASE		U(0x0005A000)
+#define LPDEMO_RETCSR_MAGIC		U(0x52534352)	/* "RCSR" */
+#define LPDEMO_RETCSR_WORDS		U(384)		/* >= the 311 words TF-A uses */
+#define LPDEMO_RETCSR_HDR_SIZE		U(16)
+
+/* Trace kept across a reset (struct lpdemo_trace) */
+#define LPDEMO_TRACE_BASE		U(0x0005A800)
+#define LPDEMO_TRACE_OFF_BL31_STAGE	U(0x08)
+#define LPDEMO_TRACE_OFF_SUSP_COUNT	U(0x10)
+#define LPDEMO_TRACE_OFF_SUSP_MODE	U(0x18)
+
+/* Debug output: console SCIF0 (kept running by Linux with console_suspend=N only) */
+#define LPDEMO_SCIF_BASE		U(0x100AC000)
+#define LPDEMO_SCIF_FTDR		(LPDEMO_SCIF_BASE + U(0x06))
+#define LPDEMO_SCIF_FDR			(LPDEMO_SCIF_BASE + U(0x0E))
+
+/* Wake-up: MHU software interrupt ch4 (CM33 -> CA55 core 0) = GIC SPI 74 */
+#define LPDEMO_GIC_INTID_WAKE		U(106)		/* SPI 74 */
+#define LPDEMO_MHU_BASE			U(0x10400000)
+#define LPDEMO_MHU_SW_INT_STS4		(LPDEMO_MHU_BASE + U(0x840))
+#define LPDEMO_MHU_SW_INT_CLR4		(LPDEMO_MHU_BASE + U(0x848))
+
+#endif /* LPDEMO_DISP_H */
