From b5b06d58300569f0657867d2df734488f02a3600 Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Wed, 14 Oct 2026 13:35:59 +0900
Subject: [PATCH] arm64: dts: renesas: rzg3l-smarc: hand RIIC0 over to the CM33
 (LowPower Display demo)

- Disable i2c0: the CM33 firmware reads the ISL28022 power monitor on
  I2C_PM. Disable the audio nodes that take their clocks from the
  5P35023 on that bus.
- Describe the SRAM control block shared with the CM33 firmware
  (0x5B000, 4 KiB) for uio_pdrv_genirq.
---
 .../boot/dts/renesas/r9a08g046l48-smarc.dts   |  2 +
 .../boot/dts/renesas/rzg3l-smarc-lpdemo.dtsi  | 54 +++++++++++++++++++
 2 files changed, 56 insertions(+)
 create mode 100644 arch/arm64/boot/dts/renesas/rzg3l-smarc-lpdemo.dtsi

diff --git a/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts b/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts
index 9c616a752c40..00b8da0e3f43 100644
--- a/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts
+++ b/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts
@@ -1016,3 +1016,5 @@ i2s2_cpu_endpoint: endpoint {
 	};
 };
 #endif
+
+#include "rzg3l-smarc-lpdemo.dtsi"
diff --git a/arch/arm64/boot/dts/renesas/rzg3l-smarc-lpdemo.dtsi b/arch/arm64/boot/dts/renesas/rzg3l-smarc-lpdemo.dtsi
new file mode 100644
index 000000000000..10422732fd3f
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/rzg3l-smarc-lpdemo.dtsi
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * RZ/G3L SMARC EVK: LowPower Display demo (CM33 firmware co-operation)
+ *
+ * SRAM 0x20000-0x9BFFF belongs to the CM33 firmware and the demo (BL22, control block,
+ * display lists, LP images). It is not part of the Linux memory map, so it needs no
+ * reserved-memory entry; only the control block is exposed to user space.
+ */
+
+/ {
+	/*
+	 * Shared CM33 control block (struct lpdemo_ctrl), mapped by uio_pdrv_genirq:
+	 *   options uio_pdrv_genirq of_id=renesas,rzg3l-lpdemo-ctrl
+	 * Without linux,uio-name the UIO device would be named after the node
+	 * including the unit address ("lpdemo-ctrl@5b000").
+	 */
+	lpdemo-ctrl@5b000 {
+		compatible = "renesas,rzg3l-lpdemo-ctrl";
+		reg = <0x0 0x5b000 0x0 0x1000>;
+		linux,uio-name = "lpdemo-ctrl";
+	};
+};
+
+/*
+ * RIIC0 (I2C_PM: ISL28022 power monitor, PMIC, 5P35023 clock generator) is driven by the
+ * CM33 firmware. The I2C0 module clock is kept running by r9a08g046-cpg.c.
+ */
+&i2c0 {
+	status = "disabled";
+};
+
+/*
+ * The audio clocks come from the 5P35023 (versa3) on i2c0, which is not probed any more.
+ * Disable its consumers instead of leaving them in deferred probe.
+ */
+&snd_rzg3l {
+	status = "disabled";
+};
+
+&da7212 {
+	status = "disabled";
+};
+
+&ssi0 {
+	status = "disabled";
+};
+
+&{/sound_card} {
+	status = "disabled";
+};
+
+&ssi2 {
+	status = "disabled";
+};
