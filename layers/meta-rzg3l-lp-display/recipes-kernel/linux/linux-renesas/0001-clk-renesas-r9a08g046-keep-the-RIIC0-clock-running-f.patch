From 76a61b1dc107aa1af2b396b6b34843ae733018a1 Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Wed, 14 Oct 2026 13:35:44 +0900
Subject: [PATCH 1/2] clk: renesas: r9a08g046: keep the RIIC0 clock running for
 the CM33

The RZ/G3L LowPower Display demo runs the I2C_PM bus (RIIC0, ISL28022
power monitor) from the CM33 firmware and keeps i2c0 disabled in Linux.
Nothing in Linux holds a reference on the I2C0 module clock then, so
clk_disable_unused() would gate it - and set its module stop - under the
CM33. Mark it critical.
---
 drivers/clk/renesas/r9a08g046-cpg.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/clk/renesas/r9a08g046-cpg.c b/drivers/clk/renesas/r9a08g046-cpg.c
index 66ea7c5c4872..b994f68b5244 100644
--- a/drivers/clk/renesas/r9a08g046-cpg.c
+++ b/drivers/clk/renesas/r9a08g046-cpg.c
@@ -817,6 +817,11 @@ static const unsigned int r9a08g046_crit_mod_clks[] __initconst = {
 	MOD_CLK_BASE + R9A08G046_GPIO_HCLK,
 	MOD_CLK_BASE + R9A08G046_WDT0_PCLK,
 	MOD_CLK_BASE + R9A08G046_OSTM2_PCLK,
+	/*
+	 * RIIC0 (I2C_PM) is driven by the CM33 firmware of the LowPower Display
+	 * demo (power monitor), while i2c0 is disabled in Linux.
+	 */
+	MOD_CLK_BASE + R9A08G046_I2C0_PCLK,
 	MOD_CLK_BASE + R9A08G046_DMAC_ACLK,
 	/*
 	 * The MIPI DSI and LCDC module clocks are the ones the seamless boot
