@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * RZ/G3L LowPower Display demo: hand the running display over to the CM33.
+ */
+
+#ifndef __RZG2L_DU_LPDEMO_H__
+#define __RZG2L_DU_LPDEMO_H__
+
+#include <linux/types.h>
+
+struct rzg2l_du_device;
+
+int rzg2l_du_lpdemo_init(struct rzg2l_du_device *rcdu);
+int rzg2l_du_lpdemo_enter(struct rzg2l_du_device *rcdu);
+int rzg2l_du_lpdemo_leave(struct rzg2l_du_device *rcdu);
+bool rzg2l_du_lpdemo_owned(struct rzg2l_du_device *rcdu);
+
+#endif /* __RZG2L_DU_LPDEMO_H__ */
