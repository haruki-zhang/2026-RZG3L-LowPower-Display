+static int rzg2l_du_atomic_check(struct drm_device *dev,
+				 struct drm_atomic_state *state)
+{
+	/* The CM33 owns the VSPD (LowPower Display demo): no commit may touch it */
+	if (rzg2l_du_lpdemo_owned(to_rzg2l_du_device(dev)))
+		return -EBUSY;
+
+	return drm_atomic_helper_check(dev, state);
+}
+
